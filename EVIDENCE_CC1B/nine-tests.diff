+                       "HL_LIVE_MIN_EXCHANGE_ORDER_GAP_MS": "0", "HL_LIVE_INTENT_DURABLE_WAIT_MS": "2000",
+                       "HL_LIVE_GLOBAL_LOCK_FILE": str(tmp / "engine-global.lock"),
